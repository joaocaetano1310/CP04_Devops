# ========================================================================
# Modelo de variaveis de ambiente.
#
# Copie para .env e preencha com valores reais:
#     cp .env.example .env
#
# O arquivo .env esta no .gitignore e NAO deve ser versionado.
# ========================================================================

# Banco de dados
DB_NAME=agrovision
DB_USER=agrouser
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# JWT - use uma chave de no minimo 256 bits (32 caracteres)
JWT_SECRET=troque-por-uma-chave-secreta-de-no-minimo-32-caracteres
JWT_EXPIRATION=86400000
